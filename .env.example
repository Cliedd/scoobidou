# Database
DATABASE_URL=

# Authentication (to be configured before production)
AUTH_SECRET=
ADMIN_BOOTSTRAP_TOKEN=

# Email provider
EMAIL_FROM=
RESEND_API_KEY=
# JSON array of public sources, e.g. [{"name":"France-Visas","url":"https://...","parser":"text"}]
MONITOR_SOURCES_JSON=[]

# Optional cache/search services
REDIS_URL=
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# One-time protected dataset import; leave empty after import
IMPORT_TOKEN=

# Developer API (key provisioning; keep private)
API_KEY_ADMIN_TOKEN=
# Optional Stripe preparation; no billing is performed until configured
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_WEBHOOK_SECRET=
# Server-side key used by /api/widget; never expose it in client code.
WIDGET_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
